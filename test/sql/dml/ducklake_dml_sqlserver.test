# name: test/sql/dml/ducklake_dml_sqlserver.test
# description: US2 — CREATE/INSERT/UPDATE/DELETE round-trip against a SQL Server catalog.
# group: [dml]

require ducklake

require mssql


statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}');

statement ok
USE lake;

statement ok
CREATE TABLE t(id BIGINT, val VARCHAR);

# The `||` concat below is evaluated DuckDB-side before the INSERT is dispatched to
# the SQL Server catalog — DuckLake only sends literal values to mssql_exec, not the
# expression. T-SQL's CONCAT/`+` is therefore not required here.
statement ok
INSERT INTO t SELECT i, 'row_' || i FROM range(10) t(i);

query I
SELECT COUNT(*) FROM t;
----
10

statement ok
UPDATE t SET val = 'updated' WHERE id < 5;

query I
SELECT COUNT(*) FROM t WHERE val = 'updated';
----
5

statement ok
DELETE FROM t WHERE id >= 8;

query I
SELECT COUNT(*) FROM t;
----
8

query II
SELECT id, val FROM t ORDER BY id LIMIT 3;
----
0	updated
1	updated
2	updated

# Snapshot must record the three commits (CREATE, INSERT, UPDATE-then-DELETE).

query I
SELECT COUNT(*) >= 3 FROM ducklake_snapshots('lake');
----
true
