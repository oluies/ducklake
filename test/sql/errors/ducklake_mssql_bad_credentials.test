# name: test/sql/errors/ducklake_mssql_bad_credentials.test
# description: US5 — connection failures from the mssql extension propagate to the user untouched.
# group: [errors]

require ducklake

require mssql

# Invalid password — extension's connection error must surface to the user.

statement error
ATTACH 'ducklake:mssql:Server=localhost,1433;Database=ducklakedb;User Id=sa;Password=WRONG!Password!;TrustServerCertificate=true;' AS lake (DATA_PATH '${DATA_PATH}');
----
Login failed
