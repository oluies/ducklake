{
  "description": "Run DuckLake tests using SQL Server as a catalog DBMS.",
  "on_init": "INSTALL mssql FROM community; LOAD mssql;",
  "autoloading": "none",
  "statically_loaded_extensions": [
    "core_functions",
    "parquet",
    "ducklake",
    "httpfs",
    "mssql",
    "icu"
  ],
  "test_env": [
    {
      "env_name": "DUCKLAKE_CONNECTION",
      "env_value": "mssql:Server=localhost,1433;Database=ducklakedb;User Id=sa;Password=DuckLake!2026;TrustServerCertificate=true;"
    }
  ],
  "skip_tests": [
    {
      "reason": "Tests only for DuckDB as a catalog",
      "paths": [
        "test/sql/general/missing_parquet.test",
        "test/sql/general/paths.test",
        "test/sql/general/default_path.test",
        "test/sql/autoloading/autoload_data_path.test",
        "test/sql/general/metadata_parameters.test",
        "test/sql/issues/corrupted_catalog_fault_isolation.test",
        "test/sql/metadata/ducklake_settings.test",
        "test/sql/remove_orphans/metadata_in_data_path.test"
      ]
    },
    {
      "reason": "SQL Server does not natively support STRUCT/MAP/LIST/VARIANT/GEOMETRY/HUGEINT — see skip-list.md",
      "paths": [
        "test/sql/types/struct.test",
        "test/sql/types/map.test",
        "test/sql/types/list.test",
        "test/sql/types/hugeint.test",
        "test/sql/types/uhugeint.test",
        "test/sql/types/variant.test",
        "test/sql/types/geometry.test"
      ]
    },
    {
      "reason": "Modifies connection string",
      "paths": [
        "test/sql/catalog/quoted_identifiers.test",
        "test/sql/stats/count_star_optimization_file_operations.test"
      ]
    }
  ]
}
