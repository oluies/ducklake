{
  "description": "Run DuckLake tests using Postgres as a catalog DBMS.",
  "on_init": "ATTACH 'dbname=ducklakedb' AS pg (TYPE postgres); USE pg; DROP SCHEMA public CASCADE; DROP SCHEMA IF EXISTS metadata_s1 CASCADE; DROP SCHEMA IF EXISTS metadata_s2 CASCADE; CREATE SCHEMA public;USE memory; DETACH pg; SET pg_experimental_filter_pushdown=false;",
  "autoloading": "none",
  "statically_loaded_extensions": [
    "core_functions",
    "parquet",
    "ducklake",
    "httpfs",
    "postgres_scanner",
    "icu",
    "httpfs"
  ],
  "test_env": [
    {
      "env_name": "DUCKLAKE_CONNECTION",
      "env_value": "postgres:dbname=ducklakedb"
    }
  ],
  "skip_tests": [
    {
      "reason": "Tests only for DuckDB as a catalog",
      "paths": [
        "test/sql/general/missing_parquet.test",
        "test/sql/general/paths.test",
        "test/sql/general/default_path.test",
        "test/sql/autoloading/autoload_data_path.test",
        "test/sql/general/metadata_parameters.test",
        "test/sql/issues/corrupted_catalog_fault_isolation.test",
        "test/sql/metadata/ducklake_settings.test",
        "test/sql/remove_orphans/metadata_in_data_path.test"
      ]
    },
    {
      "reason": "Modifies connection string",
      "paths": [
        "test/sql/catalog/quoted_identifiers.test",
        "test/sql/stats/count_star_optimization_file_operations.test"
      ]
    },
    {
      "reason": "Migration",
      "paths": [
        "test/sql/migration/v01_partitioned.test",
        "test/sql/migration/v01.test"
      ]
    },
    {
      "reason": "Test only for SQLite as catalog",
      "paths": [
        "test/sql/metadata/ducklake_settings_sqlite.test"
      ]
    },
    {
      "reason": "Postgres 63-byte identifier limit disables inlining for long column names",
      "paths": [
        "test/sql/data_inlining/long_column_name_inlining.test"
      ]
    },
    {
      "reason": "Postgres Locking (Not a bug, rather PG behavior)",
      "paths": [
        "test/sql/transaction/transaction_conflict_inlining.test"
      ]
    },
    {
      "reason": "Current transaction is aborted",
      "paths": [
        "test/sql/deletion_inlining/test_deletion_inlining_concurrent.test"
      ]
    },
    {
      "reason": "MSSQL backend tests \u2014 require sqlserver.json config (test/configs/sqlserver.json)",
      "paths": [
        "test/sql/metadata/ducklake_attach_sqlserver.test",
        "test/sql/metadata/ducklake_settings_sqlserver.test",
        "test/sql/metadata/ducklake_mssql_txn_pinning.test",
        "test/sql/metadata/ducklake_v10_to_v11_migration_sqlserver.test",
        "test/sql/dml/ducklake_dml_sqlserver.test",
        "test/sql/snapshots/ducklake_time_travel_sqlserver.test",
        "test/sql/concurrency/ducklake_concurrent_commits_sqlserver.test",
        "test/sql/errors/ducklake_identifier_length_sqlserver.test",
        "test/sql/errors/ducklake_mssql_missing_extension.test",
        "test/sql/errors/ducklake_mssql_bad_credentials.test",
        "test/sql/errors/ducklake_mssql_error_wrapping.test",
        "test/sql/maintenance/ducklake_expire_snapshots_sqlserver.test",
        "test/sql/maintenance/ducklake_compaction_sqlserver.test",
        "test/sql/inlined/ducklake_inlined_flush_sqlserver.test",
        "test/sql/walkthrough/ducklake_mssql_orders_walkthrough.test"
      ]
    }
  ]
}
